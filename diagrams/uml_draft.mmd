classDiagram
    direction LR

    class Owner {
        +str name
        +int available_minutes
        +str day_start_time
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +remove_pet(name: str) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(title: str) None
        +edit_task(title: str, **changes) None
        +get_pending_tasks() list~Task~
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +str frequency
        +str preferred_time
        +bool completed
        +priority_value() int
        +mark_complete() None
        +is_due_today(date) bool
    }

    class Scheduler {
        +Owner owner
        +list~tuple~ plan
        +list~Task~ skipped
        +generate_plan() list~tuple~
        +sort_tasks(tasks: list~Task~) list~Task~
        +filter_by_time(tasks: list~Task~) list~Task~
        +detect_conflicts() list~str~
        +explain_plan() str
    }

    Owner "1" *-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : needs
    Scheduler "1" --> "1" Owner : plans for
    Scheduler ..> Task : schedules

