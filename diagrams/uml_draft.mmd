classDiagram
    direction LR

    class Owner {
        +str name
        +int available_minutes
        +int day_start
        +list~str~ preferred_categories
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +remove_pet(pet: Pet) None
        +get_all_tasks() list~tuple~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(task: Task) None
        +edit_task(task: Task, **changes) None
        +get_due_tasks(today: date) list~Task~
    }

    class Task {
        +str description
        +int duration_minutes
        +str priority
        +str category
        +str frequency
        +Optional~int~ preferred_start
        +Optional~date~ last_completed
        +priority_value() int
        +mark_complete(on: date) None
        +is_complete(today: date) bool
        +is_due_today(today: date) bool
    }

    class Scheduler {
        +Owner owner
        +list~tuple~ plan
        +list~tuple~ skipped
        +generate_plan(today: date) list~tuple~
        +sort_tasks(tasks: list~tuple~) list~tuple~
        +filter_by_time(tasks: list~tuple~) list~tuple~
        +detect_conflicts() list~str~
        +explain_plan() str
    }

    Owner "1" *-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : needs
    Scheduler "1" --> "1" Owner : plans for
    Scheduler ..> Pet : reads
    Scheduler ..> Task : schedules
